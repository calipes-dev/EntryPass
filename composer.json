{
    "name": "calipes-dev/entrypass",
    "type": "project",
    "description": "Free event registration and QR check-in",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "bacon/bacon-qr-code": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
